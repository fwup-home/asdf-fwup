#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
. "${plugin_dir}/lib/utils.bash"

curl_opts=(-sSI)

if [ -n "${GITHUB_API_TOKEN:-}" ]; then
	curl_opts=("${curl_opts[@]}" -H "Authorization: token $GITHUB_API_TOKEN")
fi

response_headers=$(curl "${curl_opts[@]}" "$GH_REPO/releases/latest") ||
	fail "Could not query $GH_REPO/releases/latest"

# headers are lowercase over HTTP/2 but capitalized over HTTP/1.1, so do a case
# insensitive match. HTTP/1.1 headers are also delimited by CRLF, so strip any CRs
redirect_url=$(printf "%s\n" "$response_headers" |
	grep -i '^location:' | sed -e 's|^[^:]*: *||' | tr -d '\r') || true

if [ -z "$redirect_url" ]; then
	fail "Could not determine the latest $TOOL_NAME version: no redirect from $GH_REPO/releases/latest"
fi

version=
printf "redirect url: %s\n" "$redirect_url" >&2
if [[ "$redirect_url" == "$GH_REPO/releases" ]]; then
	version="$(list_all_versions | sort_versions | tail -n1 | xargs echo)"
else
	version="$(printf "%s\n" "$redirect_url" | sed 's|.*/tag/v\{0,1\}||')"
fi

printf "%s\n" "$version"
